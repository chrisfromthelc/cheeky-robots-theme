{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"color": {
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"palette": [
				{
					"slug": "primary-bg",
					"color": "#1a2634",
					"name": "Primary Background"
				},
				{
					"slug": "primary-bg-light",
					"color": "#243447",
					"name": "Primary Background Light"
				},
				{
					"slug": "teal-primary",
					"color": "#3aafa9",
					"name": "Teal Primary"
				},
				{
					"slug": "teal-dark",
					"color": "#2b7a78",
					"name": "Teal Dark"
				},
				{
					"slug": "teal-light",
					"color": "#4ecdc4",
					"name": "Teal Light"
				},
				{
					"slug": "orange-accent",
					"color": "#e8703a",
					"name": "Orange Accent"
				},
				{
					"slug": "cream-bg",
					"color": "#faf3e0",
					"name": "Cream Background"
				},
				{
					"slug": "gold",
					"color": "#e9c46a",
					"name": "Gold"
				},
				{
					"slug": "error-red",
					"color": "#e85d5d",
					"name": "Error Red"
				},
				{
					"slug": "blue-gray",
					"color": "#546a7b",
					"name": "Blue Gray"
				},
				{
					"slug": "white",
					"color": "#ffffff",
					"name": "White"
				},
				{
					"slug": "black",
					"color": "#000000",
					"name": "Black"
				},
				{
					"slug": "transparent",
					"color": "transparent",
					"name": "Transparent"
				},
				{
					"slug": "body-text",
					"color": "#c5d1dc",
					"name": "Body Text"
				}
			]
		},
		"layout": {
			"contentSize": "1152px",
			"wideSize": "1200px"
		},
		"spacing": {
			"units": [ "px", "rem", "em", "vh", "vw", "%" ],
			"spacingSizes": [
				{ "slug": "10", "size": "4px", "name": "4px" },
				{ "slug": "20", "size": "8px", "name": "8px" },
				{ "slug": "30", "size": "16px", "name": "16px" },
				{ "slug": "40", "size": "24px", "name": "24px" },
				{ "slug": "50", "size": "32px", "name": "32px" },
				{ "slug": "60", "size": "48px", "name": "48px" },
				{ "slug": "70", "size": "64px", "name": "64px" },
				{ "slug": "80", "size": "96px", "name": "96px" },
				{ "slug": "90", "size": "128px", "name": "128px" }
			]
		},
		"typography": {
			"dropCap": false,
			"fluid": true,
			"fontFamilies": [
				{
					"fontFamily": "'Exo', sans-serif",
					"slug": "exo",
					"name": "Exo",
					"fontFace": [
						{
							"fontFamily": "Exo",
							"fontWeight": "300",
							"fontStyle": "normal",
							"src": [ "file:./assets/fonts/exo/Exo-Light.woff2" ]
						},
						{
							"fontFamily": "Exo",
							"fontWeight": "300",
							"fontStyle": "italic",
							"src": [ "file:./assets/fonts/exo/Exo-LightItalic.woff2" ]
						},
						{
							"fontFamily": "Exo",
							"fontWeight": "400",
							"fontStyle": "normal",
							"src": [ "file:./assets/fonts/exo/Exo-Regular.woff2" ]
						}
					]
				},
				{
					"fontFamily": "'Michroma', sans-serif",
					"slug": "michroma",
					"name": "Michroma",
					"fontFace": [
						{
							"fontFamily": "Michroma",
							"fontWeight": "400",
							"fontStyle": "normal",
							"src": [ "file:./assets/fonts/michroma/Michroma-Regular.woff2" ]
						}
					]
				},
				{
					"fontFamily": "'Share Tech Mono', monospace",
					"slug": "share-tech-mono",
					"name": "Share Tech Mono",
					"fontFace": [
						{
							"fontFamily": "Share Tech Mono",
							"fontWeight": "400",
							"fontStyle": "normal",
							"src": [ "file:./assets/fonts/share-tech-mono/ShareTechMono-Regular.woff2" ]
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"size": "0.875rem",
					"name": "Small",
					"fluid": { "min": "0.8rem", "max": "0.875rem" }
				},
				{
					"slug": "medium",
					"size": "1rem",
					"name": "Medium",
					"fluid": { "min": "0.9rem", "max": "1rem" }
				},
				{
					"slug": "large",
					"size": "1.25rem",
					"name": "Large",
					"fluid": { "min": "1.1rem", "max": "1.25rem" }
				},
				{
					"slug": "x-large",
					"size": "1.5rem",
					"name": "Extra Large",
					"fluid": { "min": "1.25rem", "max": "1.5rem" }
				},
				{
					"slug": "xx-large",
					"size": "2.25rem",
					"name": "2X Large",
					"fluid": { "min": "1.75rem", "max": "2.25rem" }
				},
				{
					"slug": "xxx-large",
					"size": "3rem",
					"name": "3X Large",
					"fluid": { "min": "2rem", "max": "3rem" }
				},
				{
					"slug": "xxxx-large",
					"size": "4rem",
					"name": "4X Large",
					"fluid": { "min": "2.5rem", "max": "4rem" }
				}
			]
		},
		"useRootPaddingAwareAlignments": true
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--primary-bg)",
			"text": "var(--wp--preset--color--body-text)"
		},
		"spacing": {
			"padding": {
				"left": "var(--wp--preset--spacing--40)",
				"right": "var(--wp--preset--spacing--40)"
			}
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--exo)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"fontWeight": "300",
			"lineHeight": "1.7"
		},
		"elements": {
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--white)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--exo)",
					"fontWeight": "400",
					"lineHeight": "1.2"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xxxx-large)"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xxx-large)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--teal-primary)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--teal-light)"
					}
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--orange-accent)",
					"text": "var(--wp--preset--color--white)"
				},
				"border": {
					"radius": "4px"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--exo)",
					"fontSize": "var(--wp--preset--font-size--medium)",
					"fontWeight": "400",
					"textTransform": "uppercase",
					"letterSpacing": "1px"
				},
				":hover": {
					"color": {
						"background": "#d4602e"
					}
				}
			}
		},
		"blocks": {
			"core/code": {
				"color": {
					"background": "var(--wp--preset--color--primary-bg)",
					"text": "var(--wp--preset--color--teal-primary)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--share-tech-mono)",
					"fontSize": "var(--wp--preset--font-size--small)"
				},
				"border": {
					"radius": "0",
					"width": "0"
				},
				"spacing": {
					"padding": {
						"top": "var(--wp--preset--spacing--40)",
						"bottom": "var(--wp--preset--spacing--40)",
						"left": "var(--wp--preset--spacing--40)",
						"right": "var(--wp--preset--spacing--40)"
					}
				}
			},
			"core/details": {
				"color": {
					"background": "var(--wp--preset--color--primary-bg-light)",
					"text": "var(--wp--preset--color--body-text)"
				},
				"border": {
					"radius": "8px",
					"width": "1px",
					"color": "var(--wp--preset--color--teal-dark)"
				},
				"spacing": {
					"padding": {
						"top": "var(--wp--preset--spacing--40)",
						"bottom": "var(--wp--preset--spacing--40)",
						"left": "var(--wp--preset--spacing--40)",
						"right": "var(--wp--preset--spacing--40)"
					},
					"margin": {
						"bottom": "var(--wp--preset--spacing--30)"
					}
				}
			},
			"core/navigation": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--exo)",
					"fontSize": "var(--wp--preset--font-size--small)",
					"textTransform": "uppercase",
					"letterSpacing": "1px"
				}
			},
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--michroma)",
					"fontSize": "var(--wp--preset--font-size--large)",
					"textTransform": "uppercase",
					"letterSpacing": "3px"
				},
				"color": {
					"text": "var(--wp--preset--color--white)"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var(--wp--preset--color--white)"
						},
						":hover": {
							"color": {
								"text": "var(--wp--preset--color--teal-primary)"
							}
						},
						"typography": {
							"textDecoration": "none"
						}
					}
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	],
	"customTemplates": [
		{
			"name": "page-about",
			"title": "About",
			"postTypes": [ "page" ]
		},
		{
			"name": "page-services",
			"title": "Services",
			"postTypes": [ "page" ]
		},
		{
			"name": "page-contact",
			"title": "Contact",
			"postTypes": [ "page" ]
		}
	]
}
